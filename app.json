{
  "expo": {
    "name": "CivicAlert",
    "slug": "civic-alert",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.civicalert.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.civicalert.app",
      "versionCode": 4,
      "icon": "./assets/icon.png",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-notifications",
      "expo-image-picker",
      "expo-location"
    ],
    "web": {
      "favicon": "./assets/favicon.png",
      "meta": {
        "permissions-policy": "unload=()"
      }
    },
    "extra": {
      "eas": {
        "projectId": "c11ecb0c-327c-453e-9180-c15c1a344f62"
      }
    },
    "owner": "sushxxs-team"
  }
}
